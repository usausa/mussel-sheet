<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="data:," />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/MusselSheet/MusselSheet.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />

    <div id="blazor-error-ui" data-nosnippet>
        An unexpected error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>

    <ReconnectModal />

    <script type="module" src="@Assets["js/reconnect.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["js/culture.js"]"></script>
    <script src="@Assets["js/download.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    // One render mode for the whole app, from the top bar switch; [ExcludeFromInteractiveRouting] pages stay static
    private IComponentRenderMode? PageRenderMode =>
        !HttpContext.AcceptsInteractiveRouting()
            ? null
            : HttpContext.Request.Cookies[RenderModes.CookieName] == RenderModes.WebAssembly
                ? InteractiveWebAssembly
                : InteractiveServer;
}
