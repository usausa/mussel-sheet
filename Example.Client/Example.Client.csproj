<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusselSheet\MusselSheet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shown by the source view of each page -->
    <EmbeddedResource Include="Components\Pages\*.razor;Components\Pages\*.razor.cs;Models\*.cs;SheetOptionsSetup.cs;..\Example\Reports\InvoiceReportBuilder.cs" LogicalName="Source/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
