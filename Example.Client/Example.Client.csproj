<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ExampleStandalone)' == 'true'">
    <DefineConstants>$(DefineConstants);EXAMPLE_STANDALONE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(ExampleStandalone)' != 'true'">
    <Content Remove="wwwroot\index.html" />
  </ItemGroup>

  <ItemGroup Condition="'$(ExampleStandalone)' == 'true'">
    <PackageReference Include="OysterReport" Version="3.0.0" />
    <Compile Include="..\Example\Reports\InvoiceReportBuilder.cs" Link="Reports\InvoiceReportBuilder.cs" />
    <Content Include="..\Example\Assets\**\*" Link="wwwroot\assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageReference Include="MudBlazor" Version="9.13.0" />
    <PackageReference Include="Usa.Smart.Text.Japanese" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusselSheet\MusselSheet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shown by the source view of each page -->
    <EmbeddedResource Include="Components\Pages\*.razor;Components\Pages\*.razor.cs;Models\*.cs;SheetOptionsSetup.cs;..\Example\Reports\InvoiceReportBuilder.cs" LogicalName="Source/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
