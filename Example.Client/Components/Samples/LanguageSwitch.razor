<MudButtonGroup OverrideStyles="false">
    <MudButton Href="@Link("en-US")" OnClick="@(() => SelectAsync("en-US"))" Size="Size.Small" Variant="@(IsJapanese ? Variant.Outlined : Variant.Filled)" Color="Color.Primary" data-enhance-nav="false">English</MudButton>
    <MudButton Href="@Link("ja-JP")" OnClick="@(() => SelectAsync("ja-JP"))" Size="Size.Small" Variant="@(IsJapanese ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" data-enhance-nav="false">日本語</MudButton>
</MudButtonGroup>
