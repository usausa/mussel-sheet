@page "/fill-handle"

<SampleFrame Title="Fill Handle" Page="typeof(FillHandlePage)" Log="log">
    <Description>Drag or double-click the corner of the selection, and hold Ctrl as a drag ends to swap copy and series.</Description>
    <Controls>
        <MudCheckBox @bind-Value="fillHandleEnabled" Label="FillHandleEnabled" Size="Size.Small" Color="Color.Primary" Dense="true" />
    </Controls>
    <ChildContent>
        <MusselSheetView Sheet="sheet"
                         FillHandleEnabled="fillHandleEnabled"
                         CellCommitted="log.CellCommitted"
                         ActiveCellChanged="log.ActiveCellChanged"
                         SelectionChanged="log.SelectionChanged"
                         MenuItemClicked="log.MenuItemClicked" />
    </ChildContent>
</SampleFrame>
