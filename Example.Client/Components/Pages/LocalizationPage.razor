@page "/localization"

<SampleFrame Title="Localization" Page="typeof(LocalizationPage)" Log="log">
    <Description>The UI culture sets the messages and the menu, and <code>Sheet.Culture</code> sets dates, numbers and the names and first day of the calendar.</Description>
    <Controls>
        <LanguageSwitch />
    </Controls>
    <ChildContent>
        <MusselSheetView Sheet="sheet"
                         CellCommitted="log.CellCommitted"
                         ActiveCellChanged="log.ActiveCellChanged"
                         SelectionChanged="log.SelectionChanged"
                         MenuItemClicked="log.MenuItemClicked" />
    </ChildContent>
    <Output>
        <p class="sample-note sample-culture">Culture: @CultureInfo.CurrentCulture.Name / UI culture: @CultureInfo.CurrentUICulture.Name / Sheet.Culture: @sheet.Culture.Name</p>
    </Output>
</SampleFrame>
