@page "/formatting"

<SampleFrame Title="Formatting" Page="typeof(FormattingPage)" Log="log">
    <Description><code>CellSettings.Style</code> sets the look of a range.</Description>
    <ChildContent>
        <MusselSheetView Sheet="sheet"
                         CellCommitted="log.OnCellCommitted"
                         ActiveCellChanged="log.OnActiveCellChanged"
                         SelectionChanged="log.OnSelectionChanged"
                         MenuItemClicked="log.OnMenuItemClicked" />
    </ChildContent>
</SampleFrame>
