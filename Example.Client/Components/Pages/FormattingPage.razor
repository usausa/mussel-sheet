@page "/formatting"

<SampleFrame Title="Formatting" Page="typeof(FormattingPage)" Log="log">
    <Description><code>CellSettings.Style</code> sets the look of a range.</Description>
    <ChildContent>
        <MusselSheetView Sheet="sheet"
                         CellCommitted="log.CellCommitted"
                         ActiveCellChanged="log.ActiveCellChanged"
                         SelectionChanged="log.SelectionChanged"
                         MenuItemClicked="log.MenuItemClicked" />
    </ChildContent>
</SampleFrame>
