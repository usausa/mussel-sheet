@page "/"

<SampleFrame Title="Getting Started" Page="typeof(GettingStartedPage)" Log="log">
    <Description><code>Sheet</code> holds the data, <code>MusselSheetView</code> shows it.</Description>
    <ChildContent>
        <MusselSheetView Sheet="sheet"
                         CellCommitted="OnCellCommitted"
                         ActiveCellChanged="log.OnActiveCellChanged"
                         SelectionChanged="log.OnSelectionChanged"
                         MenuItemClicked="log.OnMenuItemClicked" />
    </ChildContent>
</SampleFrame>
