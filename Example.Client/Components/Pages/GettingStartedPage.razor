@page "/"

<SampleFrame Title="Getting Started" Page="typeof(GettingStartedPage)" Log="log">
    <Description><code>Sheet</code> holds the data, <code>MusselSheetView</code> shows it.</Description>
    <ChildContent>
        <MusselSheetView Sheet="sheet"
                         CellCommitted="log.Callback<CellCommittedEventArgs>(OnCellCommitted)"
                         ActiveCellChanged="log.ActiveCellChanged"
                         SelectionChanged="log.SelectionChanged"
                         MenuItemClicked="log.MenuItemClicked" />
    </ChildContent>
</SampleFrame>
